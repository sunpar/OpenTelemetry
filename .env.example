# Non-secret local defaults for the Agent OpenTelemetry trial.
AOTEL_ENV=local
AOTEL_PUBLIC_ENDPOINT=http://localhost:8088
AOTEL_OTLP_UPSTREAM=http://127.0.0.1:4318

# Native FastAPI auth and OTLP gateway.
AUTH_API_HOST=127.0.0.1
AUTH_API_PORT=8088
AUTH_API_DB_PATH=./auth-api.sqlite3
AOTEL_GATEWAY_MAX_BODY_BYTES=33554432

# Authenticated gateway ingress.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8088

# Optional legacy Compose validation settings.
GATEWAY_NETWORK=agent-otel-gateway
SIGNOZ_NETWORK=signoz-net
SIGNOZ_VENDOR_DIR=.vendor/signoz
